/*
 * ClinkLab · Apple-inspired Mini Program UI System
 *
 * Usage:
 * 1. Add this file to app.wxss or import it from a page wxss.
 * 2. Use the utility classes below to keep spacing, hierarchy and states consistent.
 * 3. This is a visual source only; it does not contain business logic.
 */

page {
  --apple-blue: #007aff;
  --apple-blue-soft: #eaf4ff;
  --apple-text: #111318;
  --apple-secondary: #6d7179;
  --apple-tertiary: #9a9ea6;
  --apple-separator: rgba(17, 19, 24, .08);
  --apple-background: #f7f7f8;
  --apple-surface: #ffffff;
  --apple-green: #22a06b;
  --apple-orange: #b7791f;
  --apple-red: #d64545;
  --apple-radius-sm: 14rpx;
  --apple-radius-md: 18rpx;
  --apple-radius-lg: 24rpx;
  --apple-shadow: 0 10rpx 32rpx rgba(20, 24, 32, .05);

  background: var(--apple-background);
  color: var(--apple-text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* Layout */
.apple-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 0 56rpx;
}
.apple-section { margin: 0 24rpx 28rpx; }
.apple-card {
  box-sizing: border-box;
  margin: 16rpx 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(17, 19, 24, .06);
  border-radius: var(--apple-radius-lg);
  background: var(--apple-surface);
  box-shadow: var(--apple-shadow);
}
.apple-card--flat { box-shadow: none; }
.apple-row { display: flex; align-items: center; }
.apple-row--between { justify-content: space-between; }
.apple-row--top { align-items: flex-start; }
.apple-wrap { flex-wrap: wrap; }
.apple-gap-8 { gap: 8rpx; }
.apple-gap-12 { gap: 12rpx; }
.apple-gap-16 { gap: 16rpx; }

/* Type hierarchy */
.apple-eyebrow {
  color: var(--apple-secondary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.apple-title {
  color: var(--apple-text);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -.4rpx;
  line-height: 1.25;
}
.apple-heading {
  color: var(--apple-text);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}
.apple-subheading {
  color: var(--apple-text);
  font-size: 30rpx;
  font-weight: 650;
}
.apple-body { color: var(--apple-text); font-size: 28rpx; }
.apple-caption { color: var(--apple-secondary); font-size: 24rpx; }
.apple-footnote { color: var(--apple-tertiary); font-size: 22rpx; }
.apple-link { color: var(--apple-blue); }

/* Buttons */
.apple-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: none;
  border-radius: var(--apple-radius-md);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1;
  transition: opacity .2s ease, transform .2s ease;
}
.apple-button::after { border: none; }
.apple-button:active { opacity: .72; transform: scale(.985); }
.apple-button--primary { background: var(--apple-blue); color: #fff; }
.apple-button--secondary { background: #eef0f3; color: #30343b; }
.apple-button--tinted { background: var(--apple-blue-soft); color: var(--apple-blue); }
.apple-button--outline { border: 1rpx solid var(--apple-separator); background: var(--apple-surface); color: #30343b; }
.apple-button--destructive { border: 1rpx solid rgba(214, 69, 69, .24); background: #fff; color: var(--apple-red); }
.apple-button--block { margin: 16rpx 24rpx 20rpx; }
.apple-button[disabled] { opacity: .4; transform: none; }
.apple-button--compact { min-height: 64rpx; padding: 0 20rpx; border-radius: 14rpx; font-size: 24rpx; }

/* Pills and status */
.apple-pill {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f2f4;
  color: #60656e;
  font-size: 22rpx;
  line-height: 1.3;
}
.apple-pill--success { background: #eaf8f1; color: var(--apple-green); }
.apple-pill--warning { background: #fff5e7; color: var(--apple-orange); }
.apple-pill--danger { background: #fff0f0; color: var(--apple-red); }
.apple-pill--info { background: var(--apple-blue-soft); color: var(--apple-blue); }

/* Form controls */
.apple-field { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 24rpx; }
.apple-label { color: #4d525b; font-size: 26rpx; font-weight: 500; }
.apple-input,
.apple-textarea,
.apple-picker {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid transparent;
  border-radius: var(--apple-radius-sm);
  background: #f7f8fa;
  padding: 20rpx;
  color: var(--apple-text);
  font-size: 28rpx;
}
.apple-input:focus,
.apple-textarea:focus { border-color: #b9dcff; background: #fff; }
.apple-textarea { min-height: 140rpx; }
.apple-picker { min-height: 80rpx; }

/* Information rows */
.apple-list { overflow: hidden; border-radius: var(--apple-radius-md); background: var(--apple-surface); }
.apple-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--apple-separator);
}
.apple-list-row:last-child { border-bottom: none; }
.apple-key { color: var(--apple-secondary); }
.apple-value { max-width: 68%; color: var(--apple-text); font-weight: 500; text-align: right; }
.apple-divider { height: 1rpx; margin: 24rpx 0; background: var(--apple-separator); }

/* Selection and empty states */
.apple-option {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--apple-separator);
}
.apple-option:last-child { border-bottom: none; }
.apple-option__main { flex: 1; min-width: 0; }
.apple-empty { padding: 140rpx 48rpx; color: var(--apple-secondary); font-size: 26rpx; text-align: center; }
.apple-callout { padding: 20rpx; border-radius: var(--apple-radius-md); }
.apple-callout--success { background: #eaf8f1; color: #17633f; }
.apple-callout--warning { background: #fff5e7; color: #805719; }
.apple-callout--danger { background: #fff0f0; color: #8f3030; }

/* Common page-specific primitives */
.apple-event-title { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.apple-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; color: var(--apple-secondary); font-size: 26rpx; }
.apple-avatar { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin-right: 20rpx; border-radius: 50%; background: var(--apple-blue-soft); color: var(--apple-blue); font-size: 38rpx; }
.apple-amount { color: var(--apple-blue); font-size: 52rpx; font-weight: 750; letter-spacing: -.8rpx; }
.apple-success-icon { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto 24rpx; border-radius: 50%; background: #eaf8f1; color: var(--apple-green); font-size: 64rpx; }
.apple-qr-frame { display: flex; justify-content: center; padding: 28rpx 0; }
.apple-qr { width: 420rpx; height: 420rpx; border: 1rpx solid var(--apple-separator); border-radius: 18rpx; }

/* Safe area */
.apple-safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
