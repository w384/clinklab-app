<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
    <button class="btn ghost block" bindtap="load">重试</button>
  </view>

  <block wx:else>
    <view class="card row spread">
      <view>
        <view class="regtitle">{{reg.event.title || '活动'}}</view>
        <view class="muted mt">{{reg.name}} · {{reg.option.name || '—'}}</view>
      </view>
      <text class="badge {{reg.status === 'PAID' ? 'paid' : reg.status === 'PENDING' ? 'pend' : 'dim'}}">{{reg.status_zh}}</text>
    </view>

    <view class="card" wx:if="{{reg.status === 'PAID'}}">
      <view class="sectitle">报名凭证</view>
      <view class="muted small">入场时出示此二维码给工作人员扫描 · 可长按保存</view>
      <view class="qrwrap" wx:if="{{reg.qr_data_url}}">
        <image class="qr" src="{{reg.qr_data_url}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
      </view>
      <view wx:else class="muted">凭证二维码加载中…</view>
      <view class="muted small mt">qr_token：{{reg.qr_token}}</view>
      <button class="btn ghost block" bindtap="copyToken">复制 qr_token</button>
    </view>

    <view class="card">
      <view class="sectitle">报名详情</view>
      <view class="kv"><text class="k">报名编号</text><text class="v">{{reg.registration_no}}</text></view>
      <view class="kv"><text class="k">报名类型</text><text class="v">{{reg.option.name || '—'}}</text></view>
      <view class="kv"><text class="k">金额</text><text class="v">{{reg.amount_display}}</text></view>
      <view class="kv"><text class="k">手机号</text><text class="v">{{reg.phone}}</text></view>
      <view class="kv"><text class="k">支付时间</text><text class="v">{{reg.paid_at_display || '—'}}</text></view>
      <view class="kv"><text class="k">签到状态</text><text class="v">{{reg.checked_in_display ? '已签到 ' + reg.checked_in_display : '未签到'}}</text></view>
    </view>

    <block wx:if="{{reg.status === 'PAID' && !reg.checked_in}}">
      <button class="btn danger block" bindtap="refund">申请退款</button>
    </block>
  </block>
</view>
