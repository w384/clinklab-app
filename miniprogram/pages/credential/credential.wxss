.regtitle { font-size: 32rpx; font-weight: 700; }
.sectitle { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.qrwrap { display: flex; justify-content: center; padding: 24rpx 0; }
.qr { width: 420rpx; height: 420rpx; border: 1rpx solid var(--line); border-radius: 16rpx; }
.kv { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.kv:last-child { border-bottom: none; }
.k { color: var(--muted); }
.v { font-weight: 500; }
