.sectitle { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.picker-val { background: #fff; border: 1rpx solid var(--line); border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; }
