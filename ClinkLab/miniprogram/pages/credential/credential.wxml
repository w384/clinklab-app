<view class="page">
  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:else>
    <view class="cred-head">
      <text class="cred-title">报名凭证</text>
      <text class="cred-no">{{reg.registration_no}}</text>
      <view class="badge {{badge_cls}}">{{status_zh}}</view>
    </view>

    <!-- 候补票：不出码、不核销，仅显示候补状态 -->
    <view class="card cred-card" wx:if="{{isWaitlist}}">
      <view class="waitlist-panel">
        <view class="waitlist-ico">⏳</view>
        <view class="waitlist-title">候补登记中</view>
        <view class="waitlist-desc">名额已满，你的候补已登记（免费、不占用正式名额）。若前面有人退位，我们将按序通知你。</view>
      </view>
    </view>

    <!-- 双人票：出 2 个码，各扫各核销 -->
    <view class="card cred-card" wx:elif="{{isDouble && reg.qr_data_url}}">
      <view class="qr-row">
        <view class="qr-col">
          <view class="qr-label">码 1（本人）</view>
          <view class="qr-wrap"><image src="{{reg.qr_data_url}}" mode="aspectFit" class="qr-img" /></view>
          <view class="qr-state {{reg.checked_in ? 'done' : ''}}">{{reg.checked_in ? '✓ 已核销' : '待核销'}}</view>
        </view>
        <view class="qr-col">
          <view class="qr-label">码 2（同行）</view>
          <view class="qr-wrap"><image src="{{reg.qr_data_url_2}}" mode="aspectFit" class="qr-img" /></view>
          <view class="qr-state {{reg.checked_in_2 ? 'done' : ''}}">{{reg.checked_in_2 ? '✓ 已核销' : '待核销'}}</view>
        </view>
      </view>
      <view class="cred-tip">双人同行：两张码分别出示，工作人员各扫一次即分别核销</view>
    </view>

    <!-- 单人 / 邀请：1 个码 -->
    <view class="card cred-card" wx:elif="{{reg.qr_data_url}}">
      <view class="qr-wrap">
        <image src="{{reg.qr_data_url}}" mode="aspectFit" class="qr-img" />
      </view>
      <view class="cred-tip">签到时出示此二维码，工作人员扫码确认</view>
    </view>

    <view class="card cred-card" wx:else>
      <view class="cred-tip warn">尚未生成凭证（未完成支付）</view>
    </view>

    <view class="card">
      <view class="card-title">活动信息</view>
      <view class="info-row"><text class="ico">🎟️</text><text class="val">{{reg.event ? reg.event.title : '活动'}}</text></view>
      <view class="info-row" wx:if="{{start_display}}"><text class="ico">🕐</text><text class="val">{{start_display}}</text></view>
      <view class="info-row"><text class="ico">👤</text><text class="val">{{reg.name}}</text></view>
      <view class="info-row" wx:if="{{reg.option}}"><text class="ico">🎫</text><text class="val">{{reg.option.name}}</text></view>
      <view class="info-row" wx:if="{{option_type !== 'SINGLE'}}"><text class="ico">🏷️</text><text class="val">{{isWaitlist ? '候补票' : (isDouble ? '双人票' : '邀请票')}}</text></view>
      <view class="info-row"><text class="ico">💰</text><text class="val">{{isWaitlist ? '¥0（免费候补）' : '¥' + reg.amount_display}}</text></view>
      <view class="info-row" wx:if="{{paid_at_display && !isWaitlist}}"><text class="ico">✅</text><text class="val">支付于 {{paid_at_display}}</text></view>
      <view class="info-row" wx:if="{{checked_in_display}}"><text class="ico">📍</text><text class="val ok">码1 已核销：{{checked_in_display}}</text></view>
      <view class="info-row" wx:if="{{checked_in_2_display}}"><text class="ico">📍</text><text class="val ok">码2 已核销：{{checked_in_2_display}}</text></view>
      <view class="info-row" wx:if="{{all_checked_in && isDouble}}"><text class="ico">🎉</text><text class="val ok">双人已全部核销</text></view>
    </view>

    <view class="cred-actions safe-bottom">
      <button class="btn ghost" bindtap="copyNo">复制报名编号</button>
      <button class="btn gold" bindtap="goReview" wx:if="{{can_review}}">评价本次活动</button>
      <button class="btn primary" bindtap="backHome">返回首页</button>
    </view>
  </block>
</view>
