/* 发帖 */
.page { background: #fff; min-height: 100vh; display: flex; flex-direction: column; }
.pc-wrap { flex: 1; padding: 24rpx 28rpx 160rpx; box-sizing: border-box; }
.pc-title-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pc-content-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  min-height: 260rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #3b4257;
}
.pc-images { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.pc-img-item { position: relative; width: 200rpx; height: 200rpx; border-radius: 12rpx; overflow: hidden; }
.pc-img { width: 100%; height: 100%; }
.pc-img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 24, 46, 0.6);
  color: #fff;
  font-size: 24rpx;
  border-bottom-left-radius: 12rpx;
}

/* 底部固定操作栏 */
.pc-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -6rpx 20rpx rgba(29, 57, 196, 0.04);
}
.pc-add-img {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #f4f6fb;
  font-size: 26rpx;
  color: var(--ink);
}
.pc-add-ico { font-size: 30rpx; }
.pc-add-t { font-weight: 600; }
.pc-add-count { margin-left: auto; font-size: 22rpx; color: var(--muted); }
.pc-submit {
  flex: none;
  margin: 0;
  width: 200rpx;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}
.pc-submit::after { border: none; }
.pc-submit.disabled { opacity: 0.6; }
