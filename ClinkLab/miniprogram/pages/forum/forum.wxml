<view class="page">
  <view class="forum-head">
    <view class="forum-head-l">
      <text class="forum-head-t">论坛</text>
      <text class="forum-head-d">发帖讨论 · 碰撞观点</text>
    </view>
    <view class="forum-create" bindtap="goCreate">＋ 发帖</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:elif="{{list.length === 0}}">
    <view class="empty">
      <text class="glyph">💬</text>
      还没有帖子，来发第一帖吧
    </view>
  </block>

  <block wx:else>
    <view
      class="post-card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="pc-head">
        <image class="pc-avatar" wx:if="{{item.author.avatar}}" src="{{item.author.avatar}}" mode="aspectFill" />
        <view class="pc-avatar pc-avatar-plain" wx:else>{{item.author.nickname[0]}}</view>
        <text class="pc-name">{{item.author.nickname}}</text>
        <text class="pc-time">{{item.timeText}}</text>
      </view>
      <text class="pc-title 2line">{{item.title}}</text>
      <text class="pc-content 2line" wx:if="{{item.plainContent}}">{{item.plainContent}}</text>
      <view class="pc-stats">
        <text class="st">👁 {{item.view_count}}</text>
        <text class="st">👍 {{item.like_count}}</text>
        <text class="st">💬 {{item.comment_count}}</text>
      </view>
    </view>
  </block>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</view>
