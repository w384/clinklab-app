<view class="page">
  <!-- Hero -->
  <view class="hero">
    <h1>碰杯灵感\n连接未来</h1>
    <p>分享 · 连接 · 成长</p>
    <text class="hero-art">🥂</text>
  </view>

  <!-- 精选活动 -->
  <view class="section-head">
    <text class="t">精选活动</text>
    <text class="more">全部活动</text>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:elif="{{events.length === 0}}">
    <view class="empty">
      <text class="glyph">📭</text>
      还没有可报名的活动，敬请期待
    </view>
  </block>

  <block wx:else>
    <view
      class="event-card"
      wx:for="{{events}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="cover" wx:if="{{item.cover_image}}">
        <image src="{{item.cover_image}}" mode="aspectFill" />
      </view>
      <view class="cover" wx:else>
        <text>{{item.cover_label}}</text>
      </view>
      <view class="meta">
        <view class="title-row">
          <text class="title 2line">{{item.title}}</text>
        </view>
        <view class="line">🕐 {{item.start_display}}</view>
        <view class="line">📍 {{item.location_display}}</view>
        <view class="stats-row">
          <text class="st">👁 {{item.view_count}}</text>
          <text class="st">👍 {{item.like_count}}</text>
          <text class="st">💬 {{item.comment_count}}</text>
        </view>
        <view class="foot-row">
          <text class="attend">{{item.attend_text}}</text>
          <view class="price-wrap">
            <text class="price" wx:if="{{item.has_options}}">¥{{item.min_price}} <text class="unit">起</text></text>
            <text class="price" wx:else>免费</text>
            <button class="btn gold sm" catchtap="goDetail" data-id="{{item.id}}">立即报名</button>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 为什么选择 Clink Lab -->
  <view class="section-head mt2">
    <text class="t">为什么选择 Clink Lab</text>
  </view>
  <view class="card">
    <view class="feat">
      <text class="feat-ico">👥</text>
      <view>
        <text class="feat-t">高质量社群</text>
        <text class="feat-d">连接行业精英，拓展人脉</text>
      </view>
    </view>
    <view class="feat">
      <text class="feat-ico">🎯</text>
      <view>
        <text class="feat-t">主题聚焦</text>
        <text class="feat-d">深度内容分享与实战经验</text>
      </view>
    </view>
    <view class="feat">
      <text class="feat-ico">🤝</text>
      <view>
        <text class="feat-t">体验为先</text>
        <text class="feat-d">用心打磨每一场活动</text>
      </view>
    </view>
  </view>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</view>
