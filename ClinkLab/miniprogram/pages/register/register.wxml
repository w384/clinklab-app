<view class="page">
  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:else>
    <!-- 步骤指示器 -->
    <view class="steps">
      <view class="step {{step > 1 ? 'done' : 'active'}}">
        <view class="dot">{{step > 1 ? '✓' : '1'}}</view>
        <view class="lbl">填写信息</view>
      </view>
      <view class="step-line {{step > 1 ? 'done' : ''}}"></view>
      <view class="step {{step === 2 ? 'active' : ''}}">
        <view class="dot">2</view>
        <view class="lbl">确认支付</view>
      </view>
      <view class="step-line"></view>
      <view class="step">
        <view class="dot">3</view>
        <view class="lbl">报名成功</view>
      </view>
    </view>

    <!-- 步骤1：填写信息 -->
    <block wx:if="{{step === 1}}">
      <view class="card" wx:if="{{event}}">
        <view class="card-title">活动信息</view>
        <view class="r-event-title">{{event.title}}</view>
        <view class="r-event-sub" wx:if="{{event.start_time}}">🕐 {{event.start_time}}</view>
      </view>

      <view class="card">
        <view class="card-title">报名选项</view>
        <view
          class="option-row {{selectedOptionId === item.id ? 'active' : ''}} {{item.option_type === 'WAITLIST' ? 'waitlist' : ''}} {{item.sold_out ? 'soldout' : ''}}"
          wx:for="{{options}}"
          wx:key="id"
          bindtap="onSelectOption"
          data-id="{{item.id}}"
          data-type="{{item.option_type}}"
          data-soldout="{{item.sold_out ? 1 : 0}}"
        >
          <view class="left">
            <view class="name">{{item.name}} <text class="opt-badge {{item.option_type}}">{{item.type_label}}</text></view>
            <view class="desc" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="limit {{item.sold_out ? 'soldout' : ''}}" wx:if="{{item.limit_text}}">{{item.limit_text}}</view>
          </view>
          <view class="price" wx:if="{{item.option_type !== 'WAITLIST'}}">¥{{item.price_display}}</view>
          <view class="price waitlist-tag" wx:else>免费·候补</view>
        </view>
      </view>

      <!-- 邀请票：购买需输入后台配置的"购买邀请码" -->
      <view class="card" wx:if="{{selectedOptionType === 'INVITE'}}">
        <view class="card-title">购买邀请码</view>
        <view class="r-gate-hint">该票为受邀专享，请输入主办方提供的购买邀请码（人工告知）。</view>
        <view class="field">
          <label>购买邀请码</label>
          <input class="input" placeholder="请输入购买邀请码" value="{{gateCode}}" bindinput="onGateCode" maxlength="32" />
        </view>
      </view>

      <!-- 候补票：免费、免支付、仅统计候补人数 -->
      <view class="card" wx:if="{{selectedOptionType === 'WAITLIST'}}">
        <view class="card-title">候补登记</view>
        <view class="r-gate-hint">名额满员后登记候补，免费、无需支付。候补不计入正式名额；若前面有人退位将按序通知。</view>
      </view>

      <view class="card">
        <view class="card-title">报名信息</view>
        <block wx:if="{{profileReady}}">
          <view class="info-row">
            <text class="ico">👤</text>
            <text class="val">{{profile.nickname}}</text>
          </view>
          <view class="info-row">
            <text class="ico">📱</text>
            <text class="val">{{profile.phone}}</text>
          </view>
          <view class="r-profile-hint">取自「我的」资料（首次登录时完善），无需重复填写</view>
        </block>
        <block wx:else>
          <view class="r-profile-warn">
            <view class="r-profile-warn-txt">报名需要昵称和手机号。请先在「我的」里完善资料。</view>
            <button class="btn primary r-profile-btn" bindtap="goProfile">去完善资料</button>
          </view>
        </block>
        <view class="field" wx:for="{{customFields}}" wx:key="key" wx:for-item="f">
          <label>{{f.label}}{{f.required ? ' *' : ''}}</label>
          <!-- 单选勾选字段（如 饮品：有酒/无酒/热饮） -->
          <view wx:if="{{f.type === 'choice'}}" class="choice-group">
            <view
              class="choice-item {{customValues[f.key] === opt ? 'active' : ''}}"
              wx:for="{{f.options}}"
              wx:key="*this"
              wx:for-item="opt"
              data-key="{{f.key}}"
              data-value="{{opt}}"
              bindtap="onCustomChoice"
            >
              <view class="radio">{{customValues[f.key] === opt ? '●' : '○'}}</view>
              <text>{{opt}}</text>
            </view>
          </view>
          <textarea wx:elif="{{f.type === 'textarea'}}" class="input" placeholder="{{f.required ? '必填' : '选填'}}" value="{{customValues[f.key]}}" data-key="{{f.key}}" bindinput="onCustomInput" maxlength="200" />
          <input wx:else class="input" placeholder="{{f.required ? '必填' : '选填'}}" value="{{customValues[f.key]}}" data-key="{{f.key}}" bindinput="onCustomInput" maxlength="200" />
        </view>
        <view class="field">
          <label>备注</label>
          <textarea class="input" placeholder="选填：其他需求或备注" value="{{remark}}" bindinput="onRemark" maxlength="200" />
        </view>
      </view>

      <view class="r-cta safe-bottom">
        <button
          class="btn {{selectedSoldOut ? 'gold' : (selectedOptionType === 'WAITLIST' ? 'gold' : 'primary')}}"
          bindtap="confirmCreate"
          disabled="{{busy || !profileReady || (selectedOptionType === 'INVITE' && !gateCode)}}"
        >{{selectedSoldOut ? '登记候补' : (selectedOptionType === 'WAITLIST' ? '免费登记候补' : '确认报名并支付')}}</button>
        <view class="r-cta-hint">{{selectedSoldOut ? '该票种已售罄，确认后登记候补（免费），退票后按候补顺序补位成正票并提示支付' : (selectedOptionType === 'WAITLIST' ? '候补登记免费，登记后可在「我的报名」查看' : (selectedOptionType === 'INVITE' ? '输入购买邀请码后进入支付' : '提交后进入支付，支付成功方可签到'))}}</view>
      </view>
    </block>

    <!-- 步骤2：确认支付 -->
    <block wx:if="{{step === 2 && reg}}">
      <view class="card">
        <view class="card-title">确认支付</view>
        <view class="info-row">
          <text class="ico">🎫</text>
          <text class="val">{{reg.option ? reg.option.name : '活动报名'}}</text>
        </view>
        <view class="info-row">
          <text class="ico">👤</text>
          <text class="val">{{reg.name}}</text>
        </view>
        <view class="info-row">
          <text class="ico">📱</text>
          <text class="val">{{reg.phone}}</text>
        </view>
        <view class="info-row">
          <text class="ico">💰</text>
          <text class="val strong">¥{{reg.amount_display}}</text>
        </view>
      </view>

      <view class="r-cta safe-bottom">
        <button class="btn gold" bindtap="goPay" disabled="{{busy}}">{{busy ? '支付中…' : '去支付'}}</button>
        <view class="r-cta-hint">支付后返回本小程序即可查看报名凭证</view>
      </view>
    </block>
  </block>
</view>
