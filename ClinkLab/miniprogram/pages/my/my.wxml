<view class="page">
  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:elif="{{list.length === 0}}">
    <view class="empty">
      <text class="glyph">📭</text>
      还没有报名记录，去发现好活动吧
    </view>
    <button class="btn primary my-cta" bindtap="goIndex">去看看活动</button>
  </block>

  <block wx:else>
    <view class="card my-card" wx:for="{{list}}" wx:key="id" bindtap="goCred" data-id="{{item.id}}">
      <view class="my-head">
        <text class="my-title">{{item.title}}</text>
        <text class="badge {{item.badge_cls}}">{{item.status_zh}}</text>
      </view>
      <view class="my-line" wx:if="{{item.start_display}}">🕐 {{item.start_display}}</view>
      <view class="my-line">🎫 {{item.registration_no}}</view>
      <view class="my-line ok" wx:if="{{item.checked_in}}">✅ 已签到</view>
      <view class="my-actions" catchtap="noop">
        <button class="btn ghost sm half" catchtap="goCred" data-id="{{item.id}}">查看凭证</button>
        <button class="btn gold sm half" catchtap="goPay" data-id="{{item.id}}" wx:if="{{item.status === 'PENDING' && item.amount > 0}}">去支付</button>
        <button class="btn gold sm half" catchtap="goReview" data-id="{{item.id}}" wx:if="{{item.can_review}}">评价</button>
        <button class="btn danger sm" catchtap="onCancel" data-id="{{item.id}}" wx:if="{{item.status === 'PENDING'}}">取消报名</button>
      </view>
    </view>
  </block>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</view>
