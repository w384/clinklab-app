<view class="page">
  <view class="share-head">
    <text class="share-head-t">分享</text>
    <text class="share-head-d">现场实录 · 网课回放 · 知识沉淀</text>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:elif="{{list.length === 0}}">
    <view class="empty">
      <text class="glyph">📭</text>
      还没有分享内容，敬请期待
    </view>
  </block>

  <block wx:else>
    <view
      class="share-card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="sc-cover" wx:if="{{item.cover_image}}">
        <image src="{{item.cover_image}}" mode="aspectFill" />
        <text class="sc-type">{{item.type_label}}</text>
      </view>
      <view class="sc-cover sc-cover-plain" wx:else>
        <text class="sc-glyph">{{item.type === 'VIDEO' ? '🎬' : item.type === 'COURSE' ? '📚' : '📝'}}</text>
        <text class="sc-type">{{item.type_label}}</text>
      </view>
      <view class="sc-body">
        <text class="sc-title 2line">{{item.title}}</text>
        <text class="sc-summary 2line" wx:if="{{item.summary}}">{{item.summary}}</text>
        <view class="sc-stats">
          <text class="st">👁 {{item.view_count}}</text>
          <text class="st">👍 {{item.like_count}}</text>
          <text class="st">💬 {{item.comment_count}}</text>
        </view>
        <view class="sc-more">查看详情 ›</view>
      </view>
    </view>
  </block>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</view>
