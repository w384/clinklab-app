# ClinkLab 售票 V0.1 —— 环境配置模板
# 复制为 .env 后按需填写。切勿把 .env / *.pem / certs/ 提交到版本库。

# ── 环境隔离：development | staging | production ──
APP_ENV=development

# 服务端口 / 主机
PORT=3050
HOST=127.0.0.1
# 客户端读取的 API 基址（开发可本地，staging/生产为合法 HTTPS 域名）
API_BASE_URL=http://127.0.0.1:3050

# ── 凭证 ──
# 电子票二维码 HMAC 签名密钥（生产：随机长密钥，放密钥管理服务）
TOKEN_SECRET=CHANGE-ME-TO-A-RANDOM-LONG-SECRET

# ── 微信（AppSecret 仅服务端，小程序源码禁止出现）──
WX_APPID=
WX_APPSECRET=

# ── 业务时限 ──
PAY_DEADLINE_MIN=15
TOKEN_TTL_SEC=604800
SESSION_TTL_SEC=604800

# ── 演示 ──
DEMO_USER_ID=1
