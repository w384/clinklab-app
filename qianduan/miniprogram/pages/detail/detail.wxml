<view class="page">
  <view class="sub-brand"><text class="back-mark">‹</text><text>Event detail</text><text class="sub-brand-cn">活动详情</text></view>
  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:else>
    <!-- 头部 -->
    <view class="d-hero">
      <text class="d-hero-title">{{event.title}}</text>
      <text class="d-hero-sub" wx:if="{{event.subtitle}}">{{event.subtitle}}</text>
    </view>

    <!-- 基本信息 -->
    <view class="card">
      <text class="d-title">{{event.title}}</text>
      <view class="info-row mt">
        <text class="ico">🕐</text>
        <text class="val">{{time_display}}</text>
      </view>
      <view class="info-row">
        <text class="ico">📍</text>
        <text class="val">{{location_display}}</text>
      </view>
      <view class="info-row" wx:if="{{reg_window}}">
        <text class="ico">📝</text>
        <text class="val muted">报名：{{reg_window}}</text>
      </view>
    </view>

    <!-- 活动介绍 -->
    <view class="card">
      <view class="card-title">活动介绍</view>
      <text class="d-desc">{{desc}}</text>
      <view class="tag-wrap" wx:if="{{tags.length}}">
        <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 报名选项 -->
    <view class="card" wx:if="{{options.length}}">
      <view class="card-title">报名选项</view>
      <view class="d-opt" wx:for="{{options}}" wx:key="id">
        <view>
          <text class="d-opt-name">{{item.name}}</text>
          <text class="d-opt-tag" wx:if="{{item.recommended}}">推荐</text>
          <text class="d-opt-desc" wx:if="{{item.description}}">{{item.description}}</text>
        </view>
        <text class="d-opt-price">¥{{item.price_display}}</text>
      </view>
    </view>

    <!-- 立即报名 -->
    <view class="d-cta safe-bottom">
      <button class="btn primary" bindtap="goRegister" disabled="{{event.full}}">
        {{event.full ? '已满员' : '立即报名'}}
      </button>
      <text class="d-cta-hint" wx:if="{{refund_zh}}">退款规则：{{refund_zh}}</text>
    </view>
  </block>
</view>
