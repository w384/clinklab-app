/* 支付结果页 */
.pr-icon { width: 120rpx; height: 120rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 64rpx; margin: 60rpx auto 0; }
.pr-icon.ok { background: var(--ok-soft); color: var(--ok); }
.pr-icon.warn { background: #fff6e0; color: var(--warn); }
.pr-icon.err { background: #fdecec; color: var(--err); }
.pr-title { text-align: center; font-size: 36rpx; font-weight: 700; margin-top: 28rpx; }
.pr-sub { text-align: center; font-size: 25rpx; color: var(--muted); margin-top: 12rpx; }
.pr-card { margin-top: 40rpx; }
.pr-cta { padding: 24rpx 20rpx; }
.pr-cta .btn { margin-bottom: 20rpx; }
.sub-brand { display:flex; align-items:center; height:84rpx; padding:0 28rpx; background:#1644d7; color:#fff; font-size:30rpx; font-weight:700; }
.sub-brand-cn { margin-left:12rpx; font-size:22rpx; font-weight:400; opacity:.82; }
.pr-icon { margin-top: 72rpx; box-shadow: 0 10rpx 24rpx rgba(27,53,125,.1); }
.pr-cta { background: rgba(244,246,251,.96); }
