<view class="page">
  <view class="sub-brand"><text>Clink Lab</text><text class="sub-brand-cn">报名凭证 Credential</text></view>
  <block wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
  </block>

  <block wx:else>
    <view class="cred-head">
      <text class="cred-title">报名凭证</text>
      <text class="cred-no">{{reg.registration_no}}</text>
      <view class="badge {{badge_cls}}">{{status_zh}}</view>
    </view>

    <view class="card cred-card">
      <block wx:if="{{reg.qr_data_url}}">
        <view class="qr-wrap">
          <image src="{{reg.qr_data_url}}" mode="aspectFit" class="qr-img" />
        </view>
        <view class="cred-tip">签到时出示此二维码，工作人员扫码确认</view>
      </block>
      <block wx:else>
        <view class="cred-tip warn">尚未生成凭证（未完成支付）</view>
      </block>
    </view>

    <view class="card">
      <view class="card-title">活动信息</view>
      <view class="info-row"><text class="ico">🎟️</text><text class="val">{{reg.event ? reg.event.title : '活动'}}</text></view>
      <view class="info-row" wx:if="{{start_display}}"><text class="ico">🕐</text><text class="val">{{start_display}}</text></view>
      <view class="info-row"><text class="ico">👤</text><text class="val">{{reg.name}}</text></view>
      <view class="info-row" wx:if="{{reg.option}}"><text class="ico">🎫</text><text class="val">{{reg.option.name}}</text></view>
      <view class="info-row"><text class="ico">💰</text><text class="val">¥{{reg.amount_display}}</text></view>
      <view class="info-row" wx:if="{{paid_at_display}}"><text class="ico">✅</text><text class="val">支付于 {{paid_at_display}}</text></view>
      <view class="info-row" wx:if="{{checked_in_display}}"><text class="ico">📍</text><text class="val ok">已签到：{{checked_in_display}}</text></view>
    </view>

    <view class="cred-actions safe-bottom">
      <button class="btn ghost" bindtap="copyNo">复制报名编号</button>
      <button class="btn primary" bindtap="backHome">返回首页</button>
    </view>
  </block>
</view>
