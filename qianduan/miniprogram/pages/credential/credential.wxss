/* 报名凭证页 */
.badge.cancel { background: #eef0f4; color: #8a94a6; }
.cred-head { text-align: center; padding: 40rpx 20rpx 10rpx; }
.cred-title { font-size: 38rpx; font-weight: 700; display: block; }
.cred-no { font-size: 25rpx; color: var(--muted); margin-top: 10rpx; display: block; }
.cred-head .badge { display: inline-block; margin-top: 16rpx; }
.cred-card { text-align: center; padding: 40rpx 20rpx; }
.qr-wrap { display: flex; align-items: center; justify-content: center; padding: 20rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 20rpx; width: 480rpx; margin: 0 auto; }
.qr-img { width: 440rpx; height: 440rpx; }
.cred-tip { font-size: 24rpx; color: var(--muted); margin-top: 20rpx; }
.cred-tip.warn { color: var(--warn); }
.cred-actions { padding: 24rpx 20rpx; display: flex; gap: 16rpx; }
.cred-actions .btn { flex: 1; }
.info-row .val.ok { color: var(--ok); }
.sub-brand { display:flex; align-items:center; height:84rpx; padding:0 28rpx; background:#1644d7; color:#fff; font-size:30rpx; font-weight:700; }
.sub-brand-cn { margin-left:12rpx; font-size:22rpx; font-weight:400; opacity:.82; }
.cred-head { padding-top:34rpx; }
.cred-card { border-top: 6rpx solid #f7b718; }
.cred-actions { background: rgba(244,246,251,.96); }
